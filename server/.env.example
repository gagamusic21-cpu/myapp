# ---- Hawassa University Exams & Courses — API environment ----

# Port the API listens on (Render injects its own PORT automatically)
PORT=4000

# PostgreSQL connection string (Neon / Supabase / Render Postgres)
# Neon example:
#   postgresql://USERNAME:PASSWORD@ep-xxx.region.aws.neon.tech/huec?sslmode=require
# Supabase example (use the *pooler* string with ?pgbouncer=true for serverless):
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

# Comma-separated origins allowed by CORS — set to your Vercel URL in production
CLIENT_ORIGIN="http://localhost:5173,http://localhost:4173"

# Optional: the secret key that lets a signup create a STAFF account
STAFF_KEY=""

# Optional: override the seeded admin credentials (defaults below)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="staff123"
